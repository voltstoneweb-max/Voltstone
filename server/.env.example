# Copia este archivo como server/.env y completa los valores. NUNCA subas .env a GitHub.
PORT=4000
# Local: mongodb://127.0.0.1:27017/voltstone  |  Atlas: la cadena que te da MongoDB Atlas (con /voltstone antes del ?)
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/voltstone?retryWrites=true&w=majority
# Cadena larga y aleatoria para firmar los tokens del admin
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
# Orígenes permitidos (CORS), separados por coma. Solo el dominio, sin ruta.
CLIENT_ORIGIN=http://localhost:5173,https://TU_USUARIO.github.io
# Administrador único (lo crea el comando seed)
ADMIN_EMAIL=admin@voltstone.co
ADMIN_PASSWORD=cambia-esta-clave
# IA (opcional: sin clave, VoltBot responde con reglas simples)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Tope diario global de consultas a la IA (protege tu cuota gratis)
AI_DAILY_LIMIT=200
