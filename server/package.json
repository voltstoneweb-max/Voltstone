{
  "name": "voltstone-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "seed": "node src/seed/seed.js",
    "test": "node scripts/run-tests.mjs unit && node scripts/run-tests.mjs integration",
    "lint": "node scripts/check-syntax.mjs",
    "test:unit": "node scripts/run-tests.mjs unit --coverage",
    "test:integration": "node scripts/run-tests.mjs integration"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0"
  }
}
